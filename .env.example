# Base URL of your n8n instance (required)
BASE_URL=https://your-n8n-instance.com

# Optional: port if not included in BASE_URL
# BASE_PORT=5678

# n8n API key (required) — generate one in n8n under Settings → API
API_KEY=your-api-key-here

# Show the Notifications tab in Settings (true/false, default: true)
NOTIFICATIONS=true
